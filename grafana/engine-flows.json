    {
      "id": 4,
      "title": "Protocol breakdown",
      "type": "piechart",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 8
      },
      "datasource": {
        "type": "elasticsearch"
      },
      "targets": [
        {
          "datasource": {
            "type": "elasticsearch"
          },
          "query": "",
          "timeField": "@timestamp",
          "metrics": [
            {
              "type": "count",
              "id": "1"
            }
          ],
          "bucketAggs": [
            {
              "type": "terms",
              "field": "netflow.protocol",
              "id": "2",
              "settings": {
                "size": "10",
                "order": "desc",
                "orderBy": "1",
                "missing": "0",
                "min_doc_count": "1"
              }
            }
          ]
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "values": [
            "value",
            "percent"
          ]
        },
        "valueLabels": "name"
      },
      "fieldConfig": {
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "6"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "TCP"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "17"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "UDP"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "1"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "ICMP"

{
  "title": "Policy engine \u2014 IPFIX flows",
  "uid": "duf-engine-flows",
  "schemaVersion": 38,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "tags": [
    "dufferin",
    "policy-engine",
    "ipfix",
    "flows"

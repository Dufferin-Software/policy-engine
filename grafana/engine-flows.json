  "panels": [
    {
      "id": 1,
      "title": "Total flows",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "elasticsearch"
      },
      "targets": [
        {
          "datasource": {
            "type": "elasticsearch"
          },
          "query": "",
          "timeField": "@timestamp",
          "metrics": [
            {
              "type": "count",
              "id": "1"
            }
          ],
          "bucketAggs": []
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          }
        }
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "sum"
          ]
        },
        "colorMode": "value"
      }
    },

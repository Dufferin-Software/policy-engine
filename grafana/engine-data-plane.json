{
  "title": "Policy engine \u2014 data plane",
  "uid": "duf-engine-data-plane",
  "schemaVersion": 36,
  "refresh": "10s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "hostname",
        "label": "Hostname",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "pe-prometheus"
        },
        "query": "label_values(policy_engine_uptime_seconds, hostname)",
        "refresh": 1,
        "sort": 1,
        "hide": 0,
        "includeAll": true,
        "allValue": ".*",
        "multi": false,
        "current": {}
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Throughput \u2014 rx packets/sec (ingress)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "pe-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "pe-prometheus"
          },
          "expr": "rate(policy_engine_rx_packets_total{direction=\"ingress\",hostname=~\"$hostname\"}[1m])",
          "legendFormat": "{{instance}} {{interface}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "pps"
        }
      }
    },

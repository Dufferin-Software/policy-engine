    {
      "id": 7,
      "title": "Drop rate % of total",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "pe-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 72,
        "w": 6,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "pe-prometheus"
          },
          "expr": "100 * sum(rate(policy_engine_policy_drops_total{hostname=~\"$hostname\"}[5m])) / clamp_min(sum(rate(policy_engine_rx_packets_total{hostname=~\"$hostname\"}[5m])) + sum(rate(policy_engine_tx_packets_total{hostname=~\"$hostname\"}[5m])), 1)",
          "legendFormat": "drop %"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1
              },
              {
                "color": "red",
                "value": 10
              }
            ]
          }
        }
      }
    },

#!/bin/bash
set -e

#DEBHELPER#

# The daemon runs as the unprivileged policy-engine user (see
# policy-engine.service).  ReadWritePaths= in the unit only lifts the
# ProtectSystem=strict read-only remount — regular file permissions still
# apply — so grant the policy-engine group write access to the paths the
# Suricata integration manages:
#   /etc/suricata                        — policy-engine.yaml + env file
#   /etc/suricata/rules/policy-engine    — deployed detection rules
#   /etc/systemd/system/suricata.service.d — generated drop-in
# This must run after the debhelper token above (never spell it out here —
# dh_installdeb expands it anywhere in the file, comments included): its
# sysusers.d snippet creates the policy-engine group on a fresh install.
mkdir -p /etc/systemd/system/suricata.service.d /etc/suricata/rules
chgrp policy-engine /etc/suricata /etc/suricata/rules /etc/systemd/system/suricata.service.d
chmod g+w /etc/suricata /etc/suricata/rules /etc/systemd/system/suricata.service.d
install -d -o policy-engine -g policy-engine -m 0755 /etc/suricata/rules/policy-engine

# The generated Suricata env file used to live in /etc/default; it now lives
# in /etc/suricata where the policy-engine user can manage it.
rm -f /etc/default/suricata-policy-engine

# Suricata is a runtime dependency but must NOT run until the operator
# explicitly enables IPS/IDS via the configureInspect GraphQL mutation.
# Its own postinst starts it automatically; undo that here so it cannot
# crash-loop and consume resources on systems that do not use IPS/IDS.
if command -v systemctl >/dev/null 2>&1; then
    systemctl stop suricata 2>/dev/null || true
    systemctl disable suricata 2>/dev/null || true
    systemctl stop policy-engine-suricata-update.timer 2>/dev/null || true
    systemctl disable policy-engine-suricata-update.timer 2>/dev/null || true
fi
